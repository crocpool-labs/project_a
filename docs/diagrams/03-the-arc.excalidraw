    {
      "id": "d3-note",
      "type": "text",
      "x": 385,
      "y": 360,
      "width": 640,
      "height": 80,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
