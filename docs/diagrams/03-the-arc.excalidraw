      "groupIds": [],
      "index": "a8",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Stage 4 is largely independent of 2 and 3: it only needs the serving contract\nfrom Stage 1, which is a reason to define that contract early - and not to\nover-specify it.",
      "roughness": 1,
      "roundness": null,
      "seed": 1892572221,
      "strokeColor": "#495057",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Stage 4 is largely independent of 2 and 3: it only needs the serving contract\nfrom Stage 1, which is a reason to define that contract early - and not to\nover-specify it.",
      "textAlign": "left",
      "updated": 1793071942210,
      "version": 1,
      "versionNonce": 339363215,
      "verticalAlign": "top"
    },
    {
      "id": "d3-cap",
      "type": "text",
      "x": 40,
      "y": 510,
      "width": 940,
      "height": 60,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 1,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "a9",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "A guess at the order of travel, not a schedule. Stages may merge, split, reorder,\nor be skipped entirely once we know enough to skip them.",
      "roughness": 1,
      "roundness": null,
      "seed": 106909701,
      "strokeColor": "#495057",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "A guess at the order of travel, not a schedule. Stages may merge, split, reorder,\nor be skipped entirely once we know enough to skip them.",
      "textAlign": "left",
      "updated": 1793071935350,
      "version": 1,
      "versionNonce": 1004945171,
      "verticalAlign": "top"
    },
