      "opacity": 100,
      "originalText": "Bars 1-2 are the vehicle: how a model becomes capable, and how it gets delivered.\nBar 3 is the subject itself, and the cheapest to start on - so it runs alongside, not after.",
      "roughness": 1,
      "roundness": null,
      "seed": 1780942099,
      "strokeColor": "#495057",
